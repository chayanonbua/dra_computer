// Prisma schema เริ่มต้น สำหรับระบบจัดเก็บครุภัณฑ์คอมพิวเตอร์
// ใช้กับ SQLite — ปรับ provider เป็น postgresql ได้ภายหลังถ้าย้ายฐานข้อมูล

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// สำนัก (ลำดับชั้นบนสุด) — ถือครองครุภัณฑ์ได้โดยตรงในฐานะสำนัก
model Office {
  id             Int      @id @default(autoincrement())
  name           String
  groups         Group[]
  assetsAsOwner  Asset[]  @relation("AssetCurrentOffice")
  createdAt      DateTime @default(now())
}

// กลุ่ม (ขึ้นกับสำนัก) — ถือครองครุภัณฑ์ได้โดยตรงในฐานะกลุ่ม
model Group {
  id             Int      @id @default(autoincrement())
  name           String
  office         Office   @relation(fields: [officeId], references: [id], onDelete: Restrict)
  officeId       Int
  people         Person[]
  assetsAsOwner  Asset[]  @relation("AssetCurrentGroup")
  createdAt      DateTime @default(now())
}

// บุคคล (ขึ้นกับกลุ่ม) — ถือครองครุภัณฑ์ได้โดยตรงในฐานะบุคคล
model Person {
  id             Int      @id @default(autoincrement())
  name           String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  groupId        Int
  assetsAsOwner  Asset[]  @relation("AssetCurrentPerson")
  createdAt      DateTime @default(now())
}

// ครุภัณฑ์คอมพิวเตอร์
model Asset {
  id            Int         @id @default(autoincrement())
  assetNumber   String      @unique          // หมายเลขครุภัณฑ์
  name          String                       // ประเภทครุภัณฑ์ เช่น "คอมพิวเตอร์ตั้งโต๊ะ"
  brand         String?                      // ยี่ห้อ
  model         String?                      // รุ่น
  status        String      @default("active") // active | repairing | disposed
  acquiredAt    DateTime?                    // วันที่ได้มา
  note          String?

  disposedAt      DateTime?                  // วันที่จำหน่าย
  disposalReason  String?                    // เหตุผลการจำหน่าย

  // ครุภัณฑ์ผูกกับ "สำนัก", "กลุ่ม" หรือ "บุคคล" ระดับใดระดับหนึ่งเท่านั้น
  // หรือว่างทั้งหมดถ้ายังไม่มอบหมาย — คุมกฎนี้ในชั้น application
  currentOffice   Office?  @relation("AssetCurrentOffice", fields: [currentOfficeId], references: [id], onDelete: Restrict)
  currentOfficeId Int?
  currentGroup    Group?   @relation("AssetCurrentGroup", fields: [currentGroupId], references: [id], onDelete: Restrict)
  currentGroupId  Int?
  currentPerson   Person?  @relation("AssetCurrentPerson", fields: [currentPersonId], references: [id], onDelete: Restrict)
  currentPersonId Int?

  repairs       Repair[]
  movements     Movement[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ประวัติการซ่อม (ผูกกับครุภัณฑ์)
model Repair {
  id          Int      @id @default(autoincrement())
  asset       Asset    @relation(fields: [assetId], references: [id])
  assetId     Int
  repairedAt  DateTime                        // วันที่ซ่อม
  symptom     String                          // อาการ
  solution    String?                         // การแก้ไข
  cost        Float?                          // ค่าใช้จ่าย
  handledBy   String?                         // ผู้ดำเนินการ
  createdAt   DateTime @default(now())
}

// ประวัติการเคลื่อนย้าย (ผูกกับครุภัณฑ์)
// เมื่อบันทึกรายการใหม่ ต้องอัปเดต Asset.currentGroupId/currentPersonId ให้ตรงกับปลายทาง
model Movement {
  id          Int      @id @default(autoincrement())
  asset       Asset    @relation(fields: [assetId], references: [id])
  assetId     Int
  movedAt     DateTime                        // วันที่ย้าย
  fromOwner   String?                         // ต้นทาง (ชื่อ ณ ขณะย้าย)
  toOwner     String                          // ปลายทาง
  note        String?
  createdAt   DateTime @default(now())
}
